# Environment Variables for the Kalshi adapter.
#
# Copy this file to .env and fill in real values. .env is git-ignored and must
# NEVER be committed. The RSA private key file it points to must also stay out
# of git. Values already set in the process environment take precedence.

# --- Kalshi adapter ------------------------------------------------------------

# API key ID (the KALSHI-ACCESS-KEY header value).
KALSHI_API_KEY_ID=your-api-key-id-here

# RSA private key used to sign requests. Provide EITHER a path to the PEM file...
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem
# ...OR the PEM contents inline (takes precedence over the path if set).
# Use literal \n for newlines, e.g. KALSHI_PRIVATE_KEY_PEM="<PEM with \n line breaks>"
# KALSHI_PRIVATE_KEY_PEM=

# Base URLs (API base path /trade-api/v2 is appended automatically).
# Change these per environment (e.g. swap the demo host for production).
KALSHI_BASE_URL_HTTP=https://demo-api.kalshi.co
KALSHI_BASE_URL_WS=wss://demo-api.kalshi.co/trade-api/ws/v2
